{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caseys-lotto",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "LOTTO_DATA",
			// Replace with the id printed by: npx wrangler kv namespace create LOTTO_DATA
			"id": "624260a6596e42f1848b2b38827fcff3"
		}
	]
}